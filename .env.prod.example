# Production ortam değişkenleri — kopyala: cp .env.prod.example .env.prod
# .env.prod ASLA commit edilmez (.gitignore + .dockerignore kapsamında).
# Çalıştırma:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Dışarı açılacak HTTP portu. Önünde TLS termination yapan bir LB varsa 80 kalır.
HTTP_PORT=80

# Saat dilimi — log damgaları ve ekrandaki saat bu dilime göre.
TZ=Europe/Istanbul

# Log seviyesi: error | warn | info | debug
LOG_LEVEL=info

# Backend'in önünde kaç proxy/LB var (nginx, ingress, cloud LB).
# 0  = konteynere doğrudan erişiliyor.
# 1+ = X-Forwarded-For'un sondan N. girdisi gerçek istemci sayılır.
# DİKKAT: fazla değer, istemcinin uydurduğu XFF girdisine güvenmek demektir
# (rate limit atlatılır). Az değer ise tüm istemcileri tek kovada sayar.
TRUST_PROXY_HOPS=1

# Çapraz-origin (CORS) izinli adresler — virgülle. BOŞ = yalnız same-origin
# (önerilen; kiosk ve panel aynı sunucudan servis edilir). Joker (*) desteklenmez.
# ALLOWED_ORIGINS=https://kiosk.klab.example

# HSTS — yalnız https üzerinden gelen isteklerde gönderilir. Kurulum düz http
# ise 'false' yapın: HSTS'i bir kez alan tarayıcı bu host'u BİR YIL boyunca
# https'e çevirir ve http üzerinden erişim imkânsız hale gelir.
HSTS_ENABLED=true

# Rate limit (IP başına). Kiosk ~2 sn'de bir /api/state yoklar → dakikada ~30
# istek; varsayılan 600 birden çok ekran + panel için rahat pay bırakır.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Durum değiştiren istekler (POST) için ayrı, daha sıkı sınır.
MUTATION_RATE_LIMIT_MAX=60

# İstek gövdesi üst sınırı (bayt). Ayar yamaları birkaç yüz bayttır.
# MAX_BODY_BYTES=16384
